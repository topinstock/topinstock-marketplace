# ============================================
#   TopinStock Marketplace — Environment Variables
# ============================================

# Database (PostgreSQL via Prisma)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
DATABASE_URL="postgresql://postgres:password@localhost:5432/topinstock?schema=public"

# Next.js
NEXTAUTH_SECRET="your-secret-key-here-change-in-production"
NEXTAUTH_URL="http://localhost:3000"

# Application
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_APP_NAME="TopinStock"

# Storage (e.g., for product images — to be configured per provider)
# AWS_ACCESS_KEY_ID=""
# AWS_SECRET_ACCESS_KEY=""
# AWS_S3_BUCKET=""
# AWS_REGION=""

# Email (e.g., Resend, SendGrid, etc.)
# EMAIL_FROM=""
# EMAIL_SERVER=""

# Free LLM APIs for AI Chat Product Importer
# Opțiunea 1 (Recomandat — 14.400 cereri gratuite/zi): Groq Console -> https://console.groq.com/
# GROQ_API_KEY="gsk_..."
# Opțiunea 2 (1.500 cereri gratuite/zi): Google AI Studio -> https://aistudio.google.com/
# GEMINI_API_KEY="AIzaSy..."
