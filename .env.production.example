# ========================================================
#   TopinStock Marketplace — Producție (.env.production)
#   Copiază acest fișier în .env.production sau setează aceste
#   variabile în panoul de găzduire (Vercel / VPS / Railway / Coolify).
# ========================================================

# 1. URL & Nume Platformă
# Înlocuiește cu domeniul tău achiziționat (cu https://, fără slash la final)
NEXT_PUBLIC_APP_URL="https://topinstock.ro"
NEXTAUTH_URL="https://topinstock.ro"
NEXT_PUBLIC_APP_NAME="TopinStock"

# 2. Baza de Date
# Dacă folosești VPS sau Docker (recomandat cu SQLite local):
DATABASE_URL="file:./topinstock.db"

# Dacă folosești Vercel / serverless (care nu au disc persistent):
# Folosește un URL PostgreSQL (ex: Supabase, Neon.tech, Railway) sau Turso LibSQL:
# DATABASE_URL="postgresql://user:password@ep-host.region.aws.neon.tech/topinstock?sslmode=require"

# 3. Securitate & Sesiuni Auth
# Generează un șir secret aleatoriu (ex: `openssl rand -base64 32`)
NEXTAUTH_SECRET="inlocuieste-cu-un-secret-puternic-de-minim-32-caractere"

# 4. Email Notificări Comenzi (Opțional - SMTP pentru confirmări automate)
# SMTP_HOST="mail.topinstock.ro"
# SMTP_PORT="465"
# SMTP_USER="comenzi@topinstock.ro"
# SMTP_PASS="parola_ta_email"
# SMTP_FROM="TopinStock <comenzi@topinstock.ro>"

# 5. Date Comerciale Companie (pentru Facturi & Subsol)
NEXT_PUBLIC_COMPANY_NAME="TopinStock S.R.L."
NEXT_PUBLIC_COMPANY_CUI="RO12345678"
NEXT_PUBLIC_COMPANY_REG_COM="J40/1234/2026"
NEXT_PUBLIC_CONTACT_EMAIL="contact@topinstock.ro"
NEXT_PUBLIC_CONTACT_PHONE="0722123456"
